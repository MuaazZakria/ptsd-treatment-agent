# Copy to .env and fill in. .gitignore keeps .env out of git.

# --- Manus API ---------------------------------------------------------------
MANUS_API_KEY=
MANUS_BASE_URL=https://api.manus.ai/v2
MANUS_AGENT_PROFILE=lite            # lite | standard | max  (lite = less likely to browse)
MANUS_POLL_INTERVAL_S=2.5
MANUS_STREAM_MAX_S=1800

# Leave MANUS_API_KEY blank, or set this to 1, to run fully offline (the
# synthesis step returns a clearly-marked deterministic stub).
PTA_MANUS_OFFLINE=0

# --- data --------------------------------------------------------------------
# Leave blank to use the bundled defaults: data/evidence/ and
# data/patients/patients.json (see the "Data" section in README.md).
PTA_EVIDENCE_DIR=
PTA_PATIENTS_FILE=
PTA_CACHE_DIR=.cache
PTA_DEMO_PATIENT_LIMIT=60

# --- admin login + decisions -------------------------------------------------
# Leave blank to run without a login gate (local/offline dev only - a startup
# warning is printed). Set a real password to require it in front of every
# /api/* route except /api/login. One shared admin password, not real IAM.
PTA_ADMIN_PASSWORD=
# Optional: pin the session-signing secret so sessions survive a restart.
# Leave blank to generate a random one per process (safer default; every
# session is invalidated on restart).
PTA_SESSION_SECRET=
PTA_DECISIONS_DIR=decisions

# --- cross-origin frontend (e.g. Vercel frontend + tunnelled backend) -------
# Leave blank when the frontend is served by this app (the default, static/).
# Set to the frontend's origin(s) (comma-separated) to enable CORS and switch
# the session cookie to SameSite=None; Secure, e.g.:
# PTA_CORS_ORIGINS=https://your-frontend.vercel.app
PTA_CORS_ORIGINS=

# --- retrieval knobs (sane defaults; usually leave unset) --------------------
# PTA_TOP_K_LOCAL=3
# PTA_MAX_QUERIES=2
# PTA_MAX_FINAL_EVIDENCE=5
# PTA_EVIDENCE_CHARS=650
# PTA_MIN_USEFUL_BM25=1.0
# PTA_CHUNK_WORDS=180
# PTA_OVERLAP_WORDS=30
# PTA_MIN_CHUNK_WORDS=50
